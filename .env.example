# Railway auto-provides DATABASE_URL when you add the PostgreSQL plugin.
# Set all other variables in Railway's UI (Variables tab), NEVER in code.

# Required
DATABASE_URL=postgresql://user:pass@host:5432/dbname
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=987654321

# Alpaca (paper trading)
ALPACA_API_KEY=PK1234567890ABCDEF
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_PAPER=true

# AI Analysis (optional — system works without these)
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...

# News API (optional — free Yahoo/SEC feeds work without this)
NEWS_API_KEY=

# SEC EDGAR requires a user agent string (name + email)
SEC_USER_AGENT=Your Name you@example.com

# Dashboard auth token (any random string — append ?token=THIS to the URL once)
DASHBOARD_TOKEN=change-me-to-a-random-string

# Trading parameters (defaults shown — override as needed)
TRADING_BUDGET=5000
MAX_LOSS_PER_TRADE=50
MAX_DAILY_LOSS=150
MAX_TRADES_PER_DAY=3
MAX_ORDERS_PER_DAY=10
MIN_REWARD_RISK=1.0
NO_ENTRIES_BEFORE=09:45
NO_ENTRIES_AFTER=15:30
FLAT_BY=15:55
BROKER=alpaca

# Timezone (Railway containers use UTC by default)
TZ=America/New_York
